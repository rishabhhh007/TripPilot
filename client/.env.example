# Copy this file to .env (never commit .env)
# true  = use built-in sample data (no backend needed)
# false = call the Express backend (not built yet)
VITE_DEMO_MODE=true

# Leave EMPTY. The frontend calls relative URLs like /api/... which reach the server
# locally (Vite proxy) and on Vercel (same domain, services routing).
VITE_API_URL=